# Copy to .env and fill in. Never commit .env.
#
# Only Firebase *client* config belongs here. These values are designed to be
# public (they identify the Firebase project); access is enforced by Firestore
# security rules. Do NOT add AI / voice provider keys as EXPO_PUBLIC_* — anything
# prefixed EXPO_PUBLIC_ that the app references is embedded in the app bundle.
# Gemini and Deepgram keys live server-side as Cloud Functions secrets.

EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abc123

# Optional: point the app at the local Firebase emulators (dev only).
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=1
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.20
