{
  "name": "byt",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bash scripts/start-expo.sh",
    "start:lan": "bash scripts/start-expo.sh --go --lan",
    "start:tunnel": "bash scripts/start-tunnel.sh",
    "start:test": "bash scripts/start-test.sh",
    "qr": "node scripts/expo-qr.cjs",
    "android": "expo run:android",
    "web": "bash scripts/start-expo.sh --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "bash scripts/test-rules.sh",
    "check:env": "node scripts/check-env.cjs",
    "verify": "npm run check:env && npm run typecheck && npm run lint && npm test",
    "go-live": "bash scripts/go-live.sh",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project ascend-9d17e",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:apk:local": "cd android && ./gradlew assembleRelease",
    "build:apk": "npx eas-cli build --platform android --profile preview --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "firebase": "^12.12.1",
    "lucide-react-native": "^1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "firebase-tools": "^15.32.1",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "private": true
}
