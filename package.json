{
  "name": "byt",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bash scripts/start-expo.sh",
    "start:lan": "bash scripts/start-expo.sh --go --lan",
    "start:tunnel": "bash scripts/start-expo.sh --go --tunnel",
    "qr": "node scripts/expo-qr.cjs",
    "android": "expo run:android",
    "web": "bash scripts/start-expo.sh --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "bash scripts/test-rules.sh",
    "check:env": "node scripts/check-env.cjs",
    "verify": "npm run check:env && npm run typecheck && npm run lint && npm test",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project ascend-9d17e",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:apk:local": "cd android && ./gradlew assembleRelease",
    "build:apk": "npx eas-cli build --platform android --profile preview --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "firebase": "^12.12.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "firebase-tools": "^15.32.1",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  },
  "private": true
}
