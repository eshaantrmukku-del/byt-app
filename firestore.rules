rules_version = '2';

// BYT Firestore security rules (schema v2).
// Every user can only reach users/{their uid} and its subcollections.
// Server-owned data (credits, turn idempotency) is read-only for clients.
// Size limits must match src/features/profile/validation.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isMetric(value) {
      return value is int && value >= 1 && value <= 10;
    }

    function isIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Timestamps must be written with serverTimestamp().
    function stampedOnCreate(d) {
      return d.createdAt == request.time && d.updatedAt == request.time;
    }

    function stampedOnUpdate(d) {
      return d.updatedAt == request.time && d.createdAt == resource.data.createdAt;
    }

    // ---------- Profile: users/{uid} ----------

    function profileKeys() {
      return ['schemaVersion', 'displayName', 'email', 'dateOfBirth', 'profession', 'goalsSummary',
              'income', 'lifestyle', 'struggles', 'coachNotes', 'onboardingCompleted',
              'createdAt', 'updatedAt'];
    }

    // Checks every known profile field that is present. Prototype-era documents may
    // also carry legacy fields; those are never validated or changed here.
    function validProfileFields(d) {
      return (!('schemaVersion' in d) || d.schemaVersion == 2)
        && (!('displayName' in d) || isText(d.displayName, 1, 60))
        && (!('email' in d) || isText(d.email, 0, 254))
        && (!('dateOfBirth' in d) || d.dateOfBirth == null || isIsoDate(d.dateOfBirth))
        && (!('profession' in d) || isText(d.profession, 0, 120))
        && (!('goalsSummary' in d) || isText(d.goalsSummary, 0, 1000))
        && (!('income' in d) || isText(d.income, 0, 120))
        && (!('lifestyle' in d) || isText(d.lifestyle, 0, 1000))
        && (!('struggles' in d) || isText(d.struggles, 0, 1000))
        && (!('coachNotes' in d) || isText(d.coachNotes, 0, 2000))
        && (!('onboardingCompleted' in d) || d.onboardingCompleted is bool);
    }

    function validProfileCreate(d) {
      return d.keys().hasAll(profileKeys())
        && d.keys().hasOnly(profileKeys())
        && validProfileFields(d)
        && d.email == request.auth.token.email
        && stampedOnCreate(d);
    }

    function validProfileUpdate(d) {
      return changed().hasOnly(profileKeys())
        && validProfileFields(d)
        && d.updatedAt == request.time
        // createdAt is set once (legacy documents may not have it yet).
        && (!('createdAt' in resource.data) || d.createdAt == resource.data.createdAt)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!changed().hasAny(['email']) || d.email == request.auth.token.email);
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validProfileCreate(request.resource.data);
      allow update: if isOwner(uid) && validProfileUpdate(request.resource.data);
      // Account deletion runs on the backend.
      allow delete: if false;

      // ---------- Goals ----------
      function validGoal(d) {
        return d.keys().hasAll(['title', 'category', 'status', 'progress', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['title', 'category', 'status', 'progress', 'createdAt', 'updatedAt'])
          && isText(d.title, 1, 200)
          && d.category in ['career', 'health', 'fitness', 'personal', 'finance', 'learning', 'social', 'creativity', 'other']
          && d.status in ['active', 'paused', 'completed']
          && d.progress is int && d.progress >= 0 && d.progress <= 100;
      }

      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validGoal(request.resource.data) && stampedOnCreate(request.resource.data);
        allow update: if isOwner(uid) && validGoal(request.resource.data) && stampedOnUpdate(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // ---------- Daily check-ins (id = YYYY-MM-DD) ----------
      function validCheckIn(d, dateKey) {
        return d.keys().hasAll(['date', 'moods', 'happiness', 'stress', 'sleep', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['date', 'moods', 'happiness', 'stress', 'sleep', 'reflection', 'win', 'createdAt', 'updatedAt'])
          && isIsoDate(dateKey) && d.date == dateKey
          && d.moods is list && d.moods.size() >= 1 && d.moods.size() <= 8
          && d.moods.toSet().difference(['energized', 'balanced', 'calm', 'anxious', 'tired', 'productive', 'focused', 'overwhelmed'].toSet()).size() == 0
          && isMetric(d.happiness) && isMetric(d.stress) && isMetric(d.sleep)
          && (!('reflection' in d) || isText(d.reflection, 0, 2000))
          && (!('win' in d) || isText(d.win, 0, 500));
      }

      match /checkIns/{dateKey} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validCheckIn(request.resource.data, dateKey) && stampedOnCreate(request.resource.data);
        allow update: if isOwner(uid) && validCheckIn(request.resource.data, dateKey) && stampedOnUpdate(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // ---------- Journal ----------
      function validJournalEntry(d) {
        return d.keys().hasAll(['date', 'text', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['date', 'text', 'createdAt', 'updatedAt'])
          && isIsoDate(d.date)
          && isText(d.text, 1, 20000);
      }

      match /journal/{entryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validJournalEntry(request.resource.data) && stampedOnCreate(request.resource.data);
        allow update: if isOwner(uid) && validJournalEntry(request.resource.data) && stampedOnUpdate(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // ---------- Conversations ----------
      function validConversationCreate(d) {
        return d.keys().hasAll(['title', 'mode', 'titleEdited', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['title', 'mode', 'reflectionCheckInId', 'titleEdited', 'createdAt', 'updatedAt'])
          && isText(d.title, 1, 120)
          && d.titleEdited is bool
          && d.mode in ['normal', 'reflection']
          && (!('reflectionCheckInId' in d) || isIsoDate(d.reflectionCheckInId))
          && stampedOnCreate(d);
      }

      match /conversations/{conversationId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validConversationCreate(request.resource.data);
        // Clients may rename. Previews, summaries and messages are written by the backend.
        allow update: if isOwner(uid)
          && changed().hasOnly(['title', 'titleEdited', 'updatedAt'])
          && isText(request.resource.data.title, 1, 120)
          && request.resource.data.titleEdited is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          // Both sides of every turn are written by coachTurn / voiceTurn.
          allow create, update: if false;
          allow delete: if isOwner(uid);
        }
      }

      // ---------- Server-owned ----------
      match /private/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /turns/{turnId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
