{
  "name": "byt-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:emulator": "bash scripts/test-emulator.sh",
    "test:emulator:vitest": "vitest run --config vitest.emulator.config.ts",
    "eval": "tsx ../eval/src/run.ts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth --project demo-byt",
    "list-models": "tsx scripts/list-models.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
