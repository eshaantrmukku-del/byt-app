# EAS uses .easignore INSTEAD of .gitignore when present.
# Keep the archive small; EAS reinstalls dependencies on the build server.

# dependencies / caches
node_modules/
.tools/
.tmp-venv/
.venv*/
.expo/
dist/
web-build/
.kotlin/
.metro-health-check*

# git / IDE
.git/
.vscode/
.cursor/
*.tsbuildinfo

# native build outputs
android/app/build/
android/build/
android/.gradle/
ios/build/
ios/Pods/

# large local artifacts
*.apk
*.aab
android-build.log
store-assets/
website/
expo-dev-qr*.png
expo-dev-url.txt
expo-bundle-url.txt
*.orig.*

# tests / tooling not needed in the app binary
tests/
firestore-debug.log
firebase-debug.log

# secrets / keys — never upload. EAS builds get EXPO_PUBLIC_* values from
# EAS environment variables, not from a local .env file.
.env
.env.*
!.env.example
*.jks
*.p8
*.p12
*.key
*.keystore
!android/app/debug.keystore
android/keystore.properties
*.mobileprovision
*.pem

# debug / OS
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
app-example
